DEBUG=True
# Use hashing for instant/offline practice, or sentence_transformers for semantic search.
EMBEDDING_BACKEND=hashing
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
SIMILARITY_THRESHOLD=0.3
GENERATION_BACKEND=extractive

# Gemini is called only when local extraction cannot preserve useful content.
# Create a free key in Google AI Studio and keep it in .env; never commit it.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_SECONDS=90
GEMINI_MAX_RETRIES=2
